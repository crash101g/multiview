[Desktop Entry]
Type=Application
Name=multiview (non-sandboxed)
Comment=multiview without the OS sandbox - fallback if a feed won't play sandboxed
# @DIR@ is replaced with the folder you cloned multiview into (see README)
Exec=@DIR@/multiview.py --no-sandbox
Path=@DIR@
Icon=video-display
Terminal=false
Categories=AudioVideo;Video;Player;
StartupWMClass=multiview
